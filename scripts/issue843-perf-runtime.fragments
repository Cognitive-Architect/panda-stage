    } finally {
      record.endedAtMs = performance.now();
      record.durationMs = record.endedAtMs - record.startedAtMs;
      issue843Perf.activeWriteFrameCount -= 1;
      issue843Perf.writeFrameRecords.push(record);
    }
  };
