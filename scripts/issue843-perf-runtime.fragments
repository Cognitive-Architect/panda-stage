    if (!hiddenWindow || hiddenWindow.isDestroyed()) throw new Error('Issue #843 could not observe the hidden window.');
    issue843Perf.hiddenWindowObserved = {
      browserWindowVisible: hiddenWindow.isVisible(),
      webContentsBackgroundThrottling: hiddenWindow.webContents.getBackgroundThrottling(),
      backgroundThrottlingOptionSource: 'HiddenWindowManager BrowserWindow.webPreferences omits backgroundThrottling',
    };
    const bootstrap = `(() => {
      const rows = new Map();
      const scalarDetail = (detail) => Object.fromEntries(Object.entries(detail || {}).filter(([, value]) =>
        value === null || ['number', 'string', 'boolean'].includes(typeof value)));
      window.__pandaIssue843Diagnostics = {
        record(event, atMs, detail) {
          if (!detail || typeof detail.jobId !== 'string' || !Number.isInteger(detail.frameIndex)) return;
          const key = detail.jobId + ':' + detail.frameIndex;
          let row = rows.get(key);
          if (!row) {
            row = { jobId: detail.jobId, frameIndex: detail.frameIndex, timeMs: null, shotId: null, shotLocalTimeMs: null, events: {} };
            rows.set(key, row);
          }
          if (typeof detail.timeMs === 'number') row.timeMs = detail.timeMs;
          if (typeof detail.shotId === 'string' || detail.shotId === null) row.shotId = detail.shotId;
          if (typeof detail.shotLocalTimeMs === 'number' || detail.shotLocalTimeMs === null) row.shotLocalTimeMs = detail.shotLocalTimeMs;
          (row.events[event] ||= []).push({ atMs, detail: scalarDetail(detail) });
        },
        snapshot() {
          return {
            rows: [...rows.values()],
            visibility: { documentVisibilityState: document.visibilityState, documentHidden: document.hidden },
          };
        },
      };
      return true;
    })()`;
    await hiddenWindow.webContents.executeJavaScript(bootstrap);
  };

  const originalReleaseJob = hiddenWindowManager.releaseJob.bind(hiddenWindowManager);
