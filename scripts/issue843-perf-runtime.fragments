    const startedAtMs = performance.now();
    const match = /^frame_(\d+)\.png$/u.exec(fileName);
    const record = {
      jobId: issue843Perf.jobDirectoryIds.get(path.resolve(jobDirectory)) ?? null,
      frameIndex: match ? Number(match[1]) : null,
      fileName,
      pngByteLength: pngBytes.byteLength,
      startedAtMs,
      endedAtMs: null,
      durationMs: null,
      error: null,
    };
