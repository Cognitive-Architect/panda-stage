    const arrayBufferStats = summarizeTiming(frameTimingRows.map((row) => row.blobArrayBufferMs));
    const mainRoundTripStats = summarizeTiming(frameTimingRows.map((row) => row.mainRequestToReplyMs));
    const ipcResidualStats = summarizeTiming(frameTimingRows.map((row) => row.ipcDispatchResidualEstimateMs));
    const writeFrameStats = summarizeTiming(frameTimingRows.map((row) => row.writeFrameMs));
    const writeSlotWaitStats = summarizeTiming(frameTimingRows.map((row) => row.writeSlotWaitMs));
    const probeMs = issue843Perf.probes.reduce((sum, item) => sum + item.elapsedMs, 0);
    const encodeMs = issue843Perf.videoEncode?.elapsedMs ?? null;
    const muxMs = issue843Perf.audioMux?.elapsedMs ?? null;
    const cleanupCommitMs = issue843Perf.cleanupJobDirectoryMs + issue843Perf.commitMs;
    const stageSum = (render?.elapsedMs ?? 0) + (encodeMs ?? 0) + (muxMs ?? 0) + probeMs + cleanupCommitMs;
    const jobMs = output.elapsedMs ?? null;
    const residualMs = jobMs == null ? null : jobMs - stageSum;
    const verifierExtraMs = Math.round(performance.now() - verifierStartedAt);
    const cleanup = {
      activeJobId: exportService.getActiveJobId(),
      activeProcessCount: exportService.getActiveProcessCount(),
      outputTemporaries: temporaryCleanup.outputTemporaries,
      frameJobDirectories: temporaryCleanup.frameJobDirectories,
      preparationSnapshots: temporaryCleanup.preparationSnapshots,
      stagingRemoved: formalCommitRecords.at(-1)?.stagingRemoved ?? null,
      cancellationPathExercised: false,
      noClobberOverwritePathExercised: false,
    };
    const outputPresent = Boolean(outputBytes);
    const passed =
      formalStarts.length === 1 && job?.status === 'completed' && outputPresent && ffprobeValid &&
      projectUnchanged && assetsUnchanged && editorStatePreserved &&
      timingCoverage.complete &&
      cleanup.activeJobId === null && cleanup.activeProcessCount === 0 &&
      cleanup.outputTemporaries.length === 0 && cleanup.frameJobDirectories.length === 0 &&
      cleanup.preparationSnapshots.length === 0 && cleanup.stagingRemoved === true;
    const receipt = {
      schemaVersion: 1, issue: 843,
      status: passed ? 'MEASUREMENT_PASS' : 'MEASUREMENT_PARTIAL',
      sourceCommitSha: result.sourceCommitSha, recordedAt: new Date().toISOString(),
      runId: path.basename(fixture.root), fixtureRoot: fixture.root, projectRoot: fixture.projectRoot,
      sample: {
        source: 'Issue #827 generated sample 1, retimed for this bounded diagnostic',
        durationMs: 4_500, shots: fixtureProject.shots.length,
        shotDurationsMs: fixtureProject.shots.map((shot) => shot.durationMs),
        frames: job?.totalFrames ?? render?.totalFrames ?? null, fps: 24,
        width: 1_920, height: 1_080, assets: fixtureProject.assets.length,
        audioEvents: fixtureProject.shots.reduce((sum, shot) => sum + shot.audioClips.length, 0),
        sourceAssetHashes: assetHashesBefore,
      },
      environment: {
        platform: process.platform, architecture: process.arch, windowsRelease: os.release(),
        electronVersion: process.versions.electron, chromiumVersion: process.versions.chrome,
        nodeVersion: process.versions.node, cpuModel: os.cpus()[0]?.model ?? 'UNKNOWN',
        logicalProcessors: os.cpus().length, totalRamBytes: os.totalmem(),
        gpuStatus: 'UNKNOWN; Windows reported only virtual display adapters AspDod/AspIdd',
        packaged: app.isPackaged, ffmpegVersion: issue843Perf.videoEncode?.versionLine ?? 'UNKNOWN',
      },
      output: {
        path: outputPath, sha256: outputSha256, bytes: outputBytes?.length ?? null, ffprobeValid, externalProbeMs,
        video: { codec: video?.codec_name ?? null, pixelFormat: video?.pix_fmt ?? null,
          width: video?.width ?? null, height: video?.height ?? null, fps, frames: frameCount, durationSeconds },
        audio: { streams: audio.length, codec: audio[0]?.codec_name ?? null,
          sampleRate: audio[0]?.sample_rate ?? null, durationSeconds: audioDurationSeconds },
        externalProbeError,
      },
      timingMs: {
        setupBeforeClick: issue843Perf.clickAt == null ? null : Math.round(issue843Perf.clickAt - issue843Perf.processStartedAt),
        totalUiClickToCompleted: issue843Perf.clickAt == null || issue843Perf.uiCompletedAt == null
          ? null : Math.round(issue843Perf.uiCompletedAt - issue843Perf.clickAt),
        exportJobStartToCommit: jobMs,
        uiMinusJobApproximation: issue843Perf.clickAt == null || issue843Perf.uiCompletedAt == null || jobMs == null
          ? null : Math.round(issue843Perf.uiCompletedAt - issue843Perf.clickAt) - jobMs,
        framePipeline: render?.elapsedMs ?? null, videoEncode: encodeMs, audioMux: muxMs,
        probes: issue843Perf.probes, totalProbeMs: probeMs,
        cleanupJobDirectory: issue843Perf.cleanupJobDirectoryMs, atomicCommit: issue843Perf.commitMs,
        cleanupAndCommit: cleanupCommitMs, jobStageResidual: residualMs,
        T_renderFrames: render?.elapsedMs ?? null,
        T_stageReadyRequestToReady: stageReadyStats,
        T_rafScheduledToCallback: rafWaitStats,
        T_stageReadyIncludingRaf: stageReadyIncludingRafStats,
        T_canvasToBlob: canvasToBlobStats,
        T_blobArrayBuffer: arrayBufferStats,
        T_mainRequestToReply: mainRoundTripStats,
        T_ipcDispatchResidualEstimate: ipcResidualStats,
        T_writeFrame: writeFrameStats,
        T_writeSlotWait: writeSlotWaitStats,
        writeFrameUnionMs: round3(writeUnionMs),
        writeFrameOverlapMs: round3(Math.max(0, issue843Perf.writeFrameRecords.reduce((sum, row) => sum + (row.durationMs ?? 0), 0) - writeUnionMs)),
        rendererSnapshotMs: issue843Perf.rendererSnapshotDurationMs,
        verifierExtraAfterUiCompletion: verifierExtraMs, standaloneFfprobe: externalProbeMs,
      },
      frameTiming: {
        status: timingCoverage.complete ? 'COMPLETE' : 'PARTIAL',
        coverage: timingCoverage,
        perFrame: frameTimingRows,
        byFrameClass: {
          rendererRequestToStageReady: groupTimingStats('rendererRequestToStageReadyMs'),
          rafScheduledToCallback: groupTimingStats('rafScheduledToCallbackMs'),
          canvasToBlob: groupTimingStats('canvasToBlobMs'),
          blobArrayBuffer: groupTimingStats('blobArrayBufferMs'),
          mainRequestToReply: groupTimingStats('mainRequestToReplyMs'),
          ipcDispatchResidualEstimate: groupTimingStats('ipcDispatchResidualEstimateMs'),
          writeFrame: groupTimingStats('writeFrameMs'),
          writeSlotWait: groupTimingStats('writeSlotWaitMs'),
        },
        writeFrame: {
          sumMs: writeFrameStats.sumMs,
          wallUnionMs: round3(writeUnionMs),
          overlapMs: round3(Math.max(0, issue843Perf.writeFrameRecords.reduce((sum, row) => sum + (row.durationMs ?? 0), 0) - writeUnionMs)),
          peakConcurrentWrites: issue843Perf.peakWriteFrameCount,
        },
        clockAndOverlap: {
          rendererIntervalsUseRendererPerformanceNow: true,
          mainIntervalsUseMainPerformanceNow: true,
          absoluteTimestampsComparedAcrossProcesses: false,
          rendererRequestToFrameReadyIsNestedInsideMainRequestToReply: true,
          writeFrameCanOverlapSubsequentFrameRendering: true,
          ipcDispatchResidualMeaning: 'Main request-to-reply duration minus Renderer request-received-to-frameReady-send duration; estimated dispatch/IPC/serialization/validation/queue residual, not pure IPC copy time.',
        },
      },
      hiddenWindowObservation: {
        ...issue843Perf.hiddenWindowObserved,
        renderer: issue843Perf.rendererSnapshot?.visibility ?? null,
        rendererSnapshotError: issue843Perf.rendererSnapshotError,
      },
      renderMetrics: {
        frames: job?.totalFrames ?? null, completedFrames: job?.completedFrames ?? null,
        pngTemporaryBytes: render?.totalBytes ?? null, peakPendingWrites: render?.peakPendingWrites ?? null,
        framePipelineMemoryBytes: render?.memory ?? null,
      },
      observedSystem: {
        samplingIntervalMs: 250, samples: issue843Perf.system.sampleCount,
        peakMainProcessRssBytes: issue843Perf.system.peakMainRssBytes,
        minimumFreeRamBytes: issue843Perf.system.minimumFreeRamBytes,
        initialFreeDiskBytes: issue843Perf.system.initialFreeDiskBytes,
        minimumFreeDiskBytes: issue843Perf.system.minimumFreeDiskBytes,
        ffmpegPeakMemory: 'NOT_MEASURED',
      },
      preservation: { projectUnchanged, assetsUnchanged, editorStatePreserved,
        outputInitiallyAbsent: true, outputAppeared: outputPresent, outputSha256 },
      cleanup,
      limitations: [
        'One generated-fixture run only; p95 describes these 108 frames and is not a production-workload SLA.',
        'toBlob callback duration includes browser scheduling/PNG work and is not a direct Canvas draw-duration measurement.',
        'IPC residual is estimated by subtracting within-process durations; it is not a pure IPC serialization/copy measurement.',
        'Existing-target no-clobber rejection and cancellation were not re-exercised.',
        'GPU and FFmpeg child-process peak memory were not ascertainable.',
        'Windows Server virtual display environment is not representative of a standard desktop or packaged installer.',
      ],
      evidenceFiles: {
        saveAsScreenshot: exportRun.nativeSaveAsScreenshotPath,
        progressScreenshot: exportRun.progressScreenshotPath,
        completionScreenshot: exportRun.completedScreenshotPath,
        ffprobeJson: path.join(evidenceRoot, 'issue843-ffprobe.json'),
      },
    };
    if (externalProbe) await fsp.writeFile(
      path.join(evidenceRoot, 'issue843-ffprobe.json'), JSON.stringify(externalProbe, null, 2), 'utf8',
    );
    await fsp.writeFile(path.join(evidenceRoot, 'issue843-export-performance-receipt.json'),
      JSON.stringify(receipt, null, 2), 'utf8');
    console.log('Issue #843 receipt: ' + path.join(evidenceRoot, 'issue843-export-performance-receipt.json'));
    console.log((passed ? 'MEASUREMENT_PASS ' : 'MEASUREMENT_PARTIAL ') + fixture.root);
    mainWindow.destroy();
    hiddenWindowManager.close();
    app.exit(passed ? 0 : 2);
    return;
  }
