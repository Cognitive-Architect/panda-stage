@@ GLOBAL_DIAGNOSTICS
const formalCommitRecords = [];
const issue838Perf = {
  processStartedAt: performance.now(),
  clickAt: null, uiCompletedAt: null, jobStartedAt: null, jobCompletedAt: null,
  exportResult: null, exportCompletion: null, videoEncode: null, audioMux: null,
  probes: [], cleanupJobDirectoryMs: 0, commitMs: 0,
  system: {
    sampleCount: 0, peakMainRssBytes: process.memoryUsage().rss,
    minimumFreeRamBytes: null, initialFreeDiskBytes: null, minimumFreeDiskBytes: null,
  },
};

@@ SHORT_PROJECT
function shortIssue838Project(project) {
  const shortProject = structuredClone(project);
  shortProject.shots = shortProject.shots.map((shot, index) => {
    const audioClips = shot.audioClips.map((clip) => {
      if (index === 0 && clip.role === 'bgm') return { ...clip, startMs: 0, endMs: 1_500 };
      if (index === 0 && clip.role === 'dialogue') return { ...clip, startMs: 0, endMs: 1_000 };
      if (index === 1 && clip.role === 'dialogue') return { ...clip, startMs: 250, endMs: 1_250 };
      if (index === 2 && clip.role === 'sfx') return { ...clip, startMs: 250, endMs: 1_250 };
      return clip;
    });
    const dialogues = shot.dialogues.map((dialogue) => ({
      ...dialogue, startMs: index === 0 ? 0 : 250, endMs: index === 0 ? 1_250 : 1_400,
    }));
    return { ...shot, durationMs: 1_500, timelineEvents: [], dialogues, audioClips };
  });
  const validated = ProjectSchema.parse(shortProject);
  assert(validated.shots.length === 3, 'Issue #838 sample must have three Shots.');
  assert(validated.shots.every((shot) => shot.durationMs === 1_500), 'Issue #838 Shots must each be 1.5 seconds.');
  assert(validated.shots.some((shot) => shot.audioClips.length > 0), 'Issue #838 sample must include audio.');
  return validated;
}

