@@ CLEANUP_TIMER
  exportFileSystem = new class extends FileSystemService {
    async cleanupJobDirectory(directory) {
      const startedAt = performance.now();
      await super.cleanupJobDirectory(directory);
      if (issue838PerfMode) issue838Perf.cleanupJobDirectoryMs += Math.round(performance.now() - startedAt);
    }
    async commitFormalOutputNoReplace
@@ COMMIT_TIMER
      const commitStartedAt = performance.now();
