  const mediaAdapter = new FFmpegAdapter({ ffmpegPath: mediaTools.ffmpegPath, ffprobePath: mediaTools.ffprobePath });
  if (issue838PerfMode) {
    for (const [method, kind] of [['probeAudioFile', 'audio-source'], ['probeVideo', 'final-video']]) {
      const originalProbe = mediaAdapter[method].bind(mediaAdapter);
      mediaAdapter[method] = async (...args) => {
        const startedAt = performance.now();
        const value = await originalProbe(...args);
        issue838Perf.probes.push({ kind, elapsedMs: Math.round(performance.now() - startedAt) });
        return value;
      };
    }
  }
